{
  "name": "@rumpusroom/auth-client",
  "version": "0.1.0",
  "description": "Session and entitlement client for RumpusRoom kid PWAs. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "~3.2.0"
  }
}
